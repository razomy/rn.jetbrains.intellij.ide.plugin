<idea-plugin>
    <id>org.razomy.rn</id>
    <name>Razomy Notation (.rn)</name>
    <vendor url="https://www.razomy.org">Razomy</vendor>

    <description><![CDATA[
        Full language support for <b>Razomy Notation (<code>.rn</code>)</b> v0.3.0 — Layer 0 Universal Node &amp; Schema Notation:
        Symmetric Pentad (<code>[]</code> Stream, <code>{}</code> Form, <code>()</code> Tuple, <code>""</code> Scalar/Col-0 String, <code>#</code> Comment),
        Attached Props &amp; Slots (<code>Key{Props}(Slots)</code>), Attached Type Constructors (<code>Sql(</code>, <code>Html[</code>, <code>Scss{</code>, <code>Date"..."</code>),
        Schema Type Definitions (<code>Uuid{'pk}</code>, <code>Int(18, 120)</code>, <code>Str</code>),
        Column-0 Multiline Raw Strings, Algebraic Composition (<code>&amp;</code>, <code>^</code>, <code>/</code>),
        2D Table Formatter, Visual Auto-Numbering Inlay Hints, and multi-format file exporting.
    ]]></description>

    <change-notes><![CDATA[
        <h3>0.3.0</h3>
        <ul>
            <li>Full Razomy Notation (<code>.rn</code>) and Razomy Language (<code>.rl</code>) v0.3.0 lexer, parser, and customizable syntax highlighting.</li>
            <li>Multi-host language injection for Column-0 multiline raw strings (<code>Json"</code>, <code>Ts"</code>, <code>Sql"</code>, <code>Html"</code>, <code>Scss"</code>, <code>Sh"</code>, <code>Md"</code>, <code>Rn2"</code>, etc.).</li>
            <li>2D Relational Table visual column formatter via standard IDE Reformat Code (<code>Ctrl+Alt+L</code> / <code>Cmd+Option+L</code>).</li>
            <li>Visual auto-numbering inlay hints for Markdown headings (<code>part</code>, <code>section</code>, <code>topic</code>), ordered lists (<code>ol [</code>), and 2D tables.</li>
            <li>Topological code folding and line commenter (<code># </code>) support.</li>
            <li>Multi-format exporter actions and live preview Tool Window (JSON, YAML, Markdown, HTML, SQL, SCSS, Terraform, Protobuf, Mermaid, CSV, and canonical <code>.rn</code>).</li>
        </ul>
    ]]></change-notes>

    <depends>com.intellij.modules.platform</depends>

    <resource-bundle>messages.MyMessageBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <!-- File Type Registration (.rn and .rl) -->
        <fileType
            name="Razomy Notation"
            implementationClass="org.razomy.rn.jetbrains.intellij.ide.plugin.RnFileType"
            fieldName="INSTANCE"
            language="RN"
            extensions="rn;rl"/>

        <!-- Parser & AST -->
        <lang.parserDefinition
            language="RN"
            implementationClass="org.razomy.rn.jetbrains.intellij.ide.plugin.RnParserDefinition"/>

        <!-- Syntax Highlighting & Color Settings -->
        <lang.syntaxHighlighterFactory
            language="RN"
            implementationClass="org.razomy.rn.jetbrains.intellij.ide.plugin.RnSyntaxHighlighterFactory"/>
        <colorSettingsPage
            implementation="org.razomy.rn.jetbrains.intellij.ide.plugin.RnColorSettingsPage"/>

        <!-- Language Injection for Embedded Code Blocks (json", ts", sql", html", md", rn2", etc.) -->
        <multiHostInjector
            implementation="org.razomy.rn.jetbrains.intellij.ide.plugin.RnLanguageInjector"/>

        <!-- Code Folding & Commenter (# ) -->
        <lang.foldingBuilder
            language="RN"
            implementationClass="org.razomy.rn.jetbrains.intellij.ide.plugin.RnFoldingBuilder"/>

        <lang.commenter
            language="RN"
            implementationClass="org.razomy.rn.jetbrains.intellij.ide.plugin.RnCommenter"/>

        <!-- ToolWindow with Export Buttons & Live Preview -->
        <toolWindow
            id="MyToolWindow"
            anchor="right"
            icon="/META-INF/pluginIcon.svg"
            factoryClass="org.razomy.rn.jetbrains.intellij.ide.plugin.MyToolWindowFactory"/>

        <!-- Notifications -->
        <notificationGroup
            id="RN.Notifications"
            displayType="BALLOON"/>

        <formattingService implementation="org.razomy.rn.jetbrains.intellij.ide.plugin.RnFormattingService"/>

        <codeInsight.inlayProvider
                language="RN"
                implementationClass="org.razomy.rn.jetbrains.intellij.ide.plugin.RnVisualNumberingHintsProvider"/>

        <!-- Real-Time Syntax & JSON Schema Validation Annotator -->
        <annotator
                language="RN"
                implementationClass="org.razomy.rn.jetbrains.intellij.ide.plugin.RnAnnotator"/>

        <!-- Context-Aware IntelliSense Completion (Md tags, Schema types, Relative & Project file paths) -->
        <completion.contributor
                language="RN"
                implementationClass="org.razomy.rn.jetbrains.intellij.ide.plugin.RnCompletionContributor"/>

        <!-- File Path & Hyperlink Reference Contributor (Ctrl+Click navigation) -->
        <psi.referenceContributor
                language="RN"
                implementation="org.razomy.rn.jetbrains.intellij.ide.plugin.RnFileReferenceContributor"/>

        <!-- Settings / Preferences Page (Auto-Export on Save & Validation) -->
        <applicationConfigurable
                parentId="tools"
                instance="org.razomy.rn.jetbrains.intellij.ide.plugin.RnSettingsConfigurable"
                id="org.razomy.rn.settings.RnSettingsConfigurable"
                displayName="Razomy Notation (.rn)"/>
    </extensions>

    <projectListeners>
        <listener
                class="org.razomy.rn.jetbrains.intellij.ide.plugin.RnAutoExportSaveListener"
                topic="com.intellij.openapi.fileEditor.FileDocumentManagerListener"/>
    </projectListeners>

    <actions>
        <group id="RN.ExportActionGroup"
               text="Export Razomy Notation (.rn)"
               description="Export .rn file to JSON, YAML, Markdown, HTML, SQL, SCSS, Terraform, Protobuf, Mermaid, or CSV"
               popup="true"
               icon="/META-INF/pluginIcon.svg">
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="after" relative-to-action="CutCopyPasteGroup"/>
            <add-to-group group-id="ToolsMenu" anchor="last"/>

            <action id="RN.ExportJson"
                    class="org.razomy.rn.jetbrains.intellij.ide.plugin.ExportRnToJsonAction"
                    text="Export to JSON (.json)"/>
            <action id="RN.ExportYaml"
                    class="org.razomy.rn.jetbrains.intellij.ide.plugin.ExportRnToYamlAction"
                    text="Export to YAML (.yaml)"/>
            <action id="RN.ExportMarkdown"
                    class="org.razomy.rn.jetbrains.intellij.ide.plugin.ExportRnToMarkdownAction"
                    text="Export to Markdown (.md)"/>
            <action id="RN.ExportHtml"
                    class="org.razomy.rn.jetbrains.intellij.ide.plugin.ExportRnToHtmlAction"
                    text="Export to HTML (.html)"/>
            <action id="RN.ExportSql"
                    class="org.razomy.rn.jetbrains.intellij.ide.plugin.ExportRnToSqlAction"
                    text="Export to SQL (.sql)"/>
            <action id="RN.ExportScss"
                    class="org.razomy.rn.jetbrains.intellij.ide.plugin.ExportRnToScssAction"
                    text="Export to SCSS (.scss)"/>
            <action id="RN.ExportTerraform"
                    class="org.razomy.rn.jetbrains.intellij.ide.plugin.ExportRnToTerraformAction"
                    text="Export to Docker &amp; Terraform (.tf)"/>
            <action id="RN.ExportProto"
                    class="org.razomy.rn.jetbrains.intellij.ide.plugin.ExportRnToProtoAction"
                    text="Export to Protobuf (.proto)"/>
            <action id="RN.ExportMermaid"
                    class="org.razomy.rn.jetbrains.intellij.ide.plugin.ExportRnToMermaidAction"
                    text="Export to Mermaid (.mmd)"/>
            <action id="RN.ExportCsv"
                    class="org.razomy.rn.jetbrains.intellij.ide.plugin.ExportRnToCsvAction"
                    text="Export to CSV (.csv)"/>
            <separator/>
            <action id="RN.FormatRn"
                    class="org.razomy.rn.jetbrains.intellij.ide.plugin.FormatRnCanonicalAction"
                    text="Format Canonical .rn (1-Space)"/>
        </group>
    </actions>
</idea-plugin>