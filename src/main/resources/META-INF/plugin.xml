<idea-plugin>
    <id>org.razomy.rn</id>
    <name>Razomy Notation (.rn)</name>
    <vendor url="https://razomy.org">Razomy</vendor>

    <description><![CDATA[
        Full language support for <b>Razomy Notation (<code>.rn</code>)</b> v0.1.0 — Layer 0 Universal Stream Root,
        Symmetric Triad (<code>[]</code> Stream, <code>{}</code> Form, <code>()</code> Tuple),
        Schema Portals (<code>Sql</code>, <code>Html</code>, <code>Scss</code>, <code>Md</code>),
        Column-0 Multiline Raw Strings, Algebraic Composition (<code>&amp;</code>, <code>^</code>, <code>/</code>),
        and one-click multi-format file exporting (JSON, YAML, Markdown, HTML, SQL, SCSS, Terraform/Docker, Protobuf, Mermaid, CSV).
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <resource-bundle>messages.MyMessageBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <!-- File Type Registration (.rn and .rl) -->
        <fileType
            name="Razomy Notation"
            implementationClass="org.razomy.rn.jetbrains.intellij.ide.plugin.RnFileType"
            fieldName="INSTANCE"
            language="RazomyNotation"
            extensions="rn;rl"/>

        <!-- Parser & AST -->
        <lang.parserDefinition
            language="RazomyNotation"
            implementationClass="org.razomy.rn.jetbrains.intellij.ide.plugin.RnParserDefinition"/>

        <!-- Syntax Highlighting & Color Settings -->
        <lang.syntaxHighlighterFactory
            language="RazomyNotation"
            implementationClass="org.razomy.rn.jetbrains.intellij.ide.plugin.RnSyntaxHighlighterFactory"/>
        <colorSettingsPage
            implementation="org.razomy.rn.jetbrains.intellij.ide.plugin.RnColorSettingsPage"/>

        <!-- Language Injection for Embedded Code Blocks (json", ts", sql", html", md", rn2", etc.) -->
        <multiHostInjector
            implementation="org.razomy.rn.jetbrains.intellij.ide.plugin.RnLanguageInjector"/>

        <!-- Code Folding & Commenter (# ) -->
        <lang.foldingBuilder
            language="RazomyNotation"
            implementationClass="org.razomy.rn.jetbrains.intellij.ide.plugin.RnFoldingBuilder"/>
        <lang.commenter
            language="RazomyNotation"
            implementationClass="org.razomy.rn.jetbrains.intellij.ide.plugin.RnCommenter"/>

        <!-- ToolWindow with Export Buttons & Live Preview -->
        <toolWindow
            id="MyToolWindow"
            anchor="right"
            icon="/META-INF/pluginIcon.svg"
            factoryClass="org.razomy.rn.jetbrains.intellij.ide.plugin.MyToolWindowFactory"/>

        <!-- Notifications -->
        <notificationGroup
            id="RazomyNotation.Notifications"
            displayType="BALLOON"/>
    </extensions>

    <actions>
        <group id="RazomyNotation.ExportActionGroup"
               text="Export Razomy Notation (.rn)"
               description="Export .rn file to JSON, YAML, Markdown, HTML, SQL, SCSS, Terraform, Protobuf, Mermaid, or CSV"
               popup="true"
               icon="/META-INF/pluginIcon.svg">
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="after" relative-to-action="CutCopyPasteGroup"/>
            <add-to-group group-id="ToolsMenu" anchor="last"/>

            <action id="RazomyNotation.ExportJson"
                    class="org.razomy.rn.jetbrains.intellij.ide.plugin.ExportRnToJsonAction"
                    text="Export to JSON (.json)"/>
            <action id="RazomyNotation.ExportYaml"
                    class="org.razomy.rn.jetbrains.intellij.ide.plugin.ExportRnToYamlAction"
                    text="Export to YAML (.yaml)"/>
            <action id="RazomyNotation.ExportMarkdown"
                    class="org.razomy.rn.jetbrains.intellij.ide.plugin.ExportRnToMarkdownAction"
                    text="Export to Markdown (.md)"/>
            <action id="RazomyNotation.ExportHtml"
                    class="org.razomy.rn.jetbrains.intellij.ide.plugin.ExportRnToHtmlAction"
                    text="Export to HTML (.html)"/>
            <action id="RazomyNotation.ExportSql"
                    class="org.razomy.rn.jetbrains.intellij.ide.plugin.ExportRnToSqlAction"
                    text="Export to SQL (.sql)"/>
            <action id="RazomyNotation.ExportScss"
                    class="org.razomy.rn.jetbrains.intellij.ide.plugin.ExportRnToScssAction"
                    text="Export to SCSS (.scss)"/>
            <action id="RazomyNotation.ExportTerraform"
                    class="org.razomy.rn.jetbrains.intellij.ide.plugin.ExportRnToTerraformAction"
                    text="Export to Docker &amp; Terraform (.tf)"/>
            <action id="RazomyNotation.ExportProto"
                    class="org.razomy.rn.jetbrains.intellij.ide.plugin.ExportRnToProtoAction"
                    text="Export to Protobuf (.proto)"/>
            <action id="RazomyNotation.ExportMermaid"
                    class="org.razomy.rn.jetbrains.intellij.ide.plugin.ExportRnToMermaidAction"
                    text="Export to Mermaid (.mmd)"/>
            <action id="RazomyNotation.ExportCsv"
                    class="org.razomy.rn.jetbrains.intellij.ide.plugin.ExportRnToCsvAction"
                    text="Export to CSV (.csv)"/>
            <separator/>
            <action id="RazomyNotation.FormatRn"
                    class="org.razomy.rn.jetbrains.intellij.ide.plugin.FormatRnCanonicalAction"
                    text="Format Canonical .rn (1-Space)"/>
        </group>
    </actions>
</idea-plugin>